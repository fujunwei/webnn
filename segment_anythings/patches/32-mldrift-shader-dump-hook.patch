ml-drift: debug hook to dump WGSL sources that mention f16

When MLD_WEBGPU_SHADER_DUMP_DIR is set, CreateComputeShaderModule writes any
shader source containing "f16" to <dir>/shader_<n>.wgsl. Intended to catch
exactly the class of bug fixed in patch 31: on devices without shader-f16,
such shaders are rejected by Dawn and the containing dispatch silently never
runs, leaving output buffers zeroed with no error surfaced to the caller.


diff --git a/ml_drift/webgpu/webgpu_api_util.cc b/ml_drift/webgpu/webgpu_api_util.cc
index 14c8782..fb9a27a 100644
--- a/ml_drift/webgpu/webgpu_api_util.cc
+++ b/ml_drift/webgpu/webgpu_api_util.cc
@@ -14,8 +14,11 @@
 
 #include "ml_drift/webgpu/webgpu_api_util.h"
 
+#include <atomic>
 #include <cstdint>
+#include <cstdlib>
 #include <cstring>
+#include <fstream>
 #include <memory>
 #include <string>
 #include <utility>
@@ -59,6 +62,20 @@ namespace ml_drift {
 namespace webgpu {
 namespace {
 
+// MapAsync on the readback buffer only completes once every command queued
+// before it has executed, so this timeout is really a budget for the whole
+// inference, not for the copy. Ten seconds is plenty for typical graphs but not
+// for very large ones on an integrated GPU. The override exists so a slow
+// device can be told apart from a wedged one.
+absl::Duration ReadbackTimeout() {
+  static const absl::Duration kTimeout = [] {
+    const char* env = std::getenv("MLD_WEBGPU_READBACK_TIMEOUT_SECONDS");
+    const int seconds = env != nullptr ? std::atoi(env) : 0;
+    return seconds > 0 ? absl::Seconds(seconds) : absl::Seconds(10);
+  }();
+  return kTimeout;
+}
+
 absl::Status ReadDataFromMappableBuffer(const wgpu::Device& device,
                                         const wgpu::Queue& queue,
                                         const wgpu::Buffer& mappable_buffer,
@@ -76,7 +93,7 @@ absl::Status ReadDataFromMappableBuffer(const wgpu::Device& device,
             status = s;
             message = std::string(msg);
           }),
-      absl::Seconds(10)));
+      ReadbackTimeout()));
 
   if (status != wgpu::MapAsyncStatus::Success) {
     return absl::InternalError(message);
@@ -219,6 +236,24 @@ absl::Status WaitUntilCompleted(const wgpu::Queue& queue,
 
 wgpu::ShaderModule CreateComputeShaderModule(const wgpu::Device& device,
                                              const std::string& src) {
+  // Debug-only: dump WGSL sources that mention f16 to
+  // $MLD_WEBGPU_SHADER_DUMP_DIR/shader_<n>.wgsl. On devices without the
+  // shader-f16 feature such sources are rejected by Dawn ("'f16' type used
+  // without 'f16' extension enabled") and the dispatch silently never runs,
+  // leaving the output buffers zero-initialized.
+  if (src.find("f16") != std::string::npos) {
+    if (const char* dir = std::getenv("MLD_WEBGPU_SHADER_DUMP_DIR")) {
+      static std::atomic<int> counter{0};
+      std::string path =
+          absl::StrCat(dir, "/shader_", counter.fetch_add(1), ".wgsl");
+      std::ofstream out(path, std::ios::binary);
+      if (out) {
+        out << src;
+        ABSL_LOG(ERROR) << "[shader-dump] wrote " << path << " ("
+                        << src.size() << " bytes)";
+      }
+    }
+  }
   wgpu::ShaderSourceWGSL wgsl;
   wgsl.code = src.c_str();
   wgpu::ShaderModuleDescriptor descriptor;
