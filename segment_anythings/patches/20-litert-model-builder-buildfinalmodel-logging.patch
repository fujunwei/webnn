litert: log BuildFinalModel build/transform progress

Adds TF_LITE_KERNEL_LOG markers around BuildModel and
ApplyGpuModelTransformations for diagnosis.

diff --git a/ml_drift_delegate/tflite/model_builder.cc b/ml_drift_delegate/tflite/model_builder.cc
index a749b355c..480c20679 100755
--- a/ml_drift_delegate/tflite/model_builder.cc
+++ b/ml_drift_delegate/tflite/model_builder.cc
@@ -7262,12 +7511,18 @@ absl::Status BuildFinalModel(
     const TensorIndexToBufferIdMap* tensor_to_buffer_id_map,
     const TensorIndexToExternalBufferIdMap* tensor_to_external_buffer_id_map,
     TFLiteStablehloCompositeParserFactory* composite_parser_factory) {
+  TF_LITE_KERNEL_LOG(context, "[WebNN][BuildFinalModel] BuildModel START");
   RETURN_IF_ERROR(
       BuildModel(context, delegate_params, options, graph, quant_conversion_map,
                  shared_tensors, tensor_to_buffer_id_map,
                  tensor_to_external_buffer_id_map, composite_parser_factory));
+  TF_LITE_KERNEL_LOG(context,
+                     "[WebNN][BuildFinalModel] BuildModel DONE, "
+                     "running transformations...");
 
-  return ApplyGpuModelTransformations(graph);
+  auto result = ApplyGpuModelTransformations(graph);
+  TF_LITE_KERNEL_LOG(context, "[WebNN][BuildFinalModel] Transformations DONE");
+  return result;
 }
 
 namespace {
