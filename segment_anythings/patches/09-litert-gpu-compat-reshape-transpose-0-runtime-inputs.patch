tflite: allow 0 runtime inputs for RESHAPE and TRANSPOSE GPU compat

RESHAPE and TRANSPOSE may have 0 or 1 runtime inputs (constant data
tensor). The GPU delegate handles both; this relaxes the previous
exactly-1 requirement.

diff --git a/tflite/tools/versioning/gpu_compatibility.cc b/tflite/tools/versioning/gpu_compatibility.cc
index 25ff8337a..96d3c8c95 100644
--- a/tflite/tools/versioning/gpu_compatibility.cc
+++ b/tflite/tools/versioning/gpu_compatibility.cc
@@ -21,6 +21,7 @@ limitations under the License.
 #include <string>
 #include <vector>
 
+#include "absl/log/absl_log.h"
 #include "absl/status/status.h"
 #include "absl/strings/str_cat.h"
 #include "absl/strings/str_format.h"
@@ -950,11 +951,27 @@ absl::Status CheckGpuDelegateCompatibility(const OpSignature& op_sig,
     case kTfLiteBuiltinPrelu:
       return absl::OkStatus();
 
-    case kTfLiteBuiltinReshape:
-      RETURN_IF_ERROR(CheckInputsOutputs(op_sig,
-                                         /*required_runtime_inputs=*/1,
-                                         /*required_outputs=*/1));
+    case kTfLiteBuiltinReshape: {
+      // RESHAPE can have 0 or 1 runtime inputs. 0 runtime inputs means the
+      // data tensor is constant (e.g. output of a folded constant dequantize
+      // or transpose). The GPU delegate handles this fine — it derives the
+      // new shape from the output tensor and ignores the shape input.
+      const int runtime_inputs = GetNumberOfRuntimeInputs(op_sig);
+      if (runtime_inputs < 0 || runtime_inputs > 1) {
+        return absl::InternalError(
+            absl::StrCat("Expected 0 or 1 runtime input tensor(s), but node "
+                         "has ", runtime_inputs, " runtime input(s)."));
+      }
+      if (op_sig.outputs.size() != 1) {
+        return absl::InternalError(
+            absl::StrCat("Expected 1 output tensor(s), but node has ",
+                         op_sig.outputs.size(), " output(s)."));
+      }
+      // ABSL_LOG(INFO) << "[WebNN][gpu_compat] RESHAPE accepted: "
+      //                << runtime_inputs << " runtime inputs, "
+      //                << op_sig.inputs.size() << " total inputs";
       return absl::OkStatus();
+    }
     case kTfLiteBuiltinSelect:
     case kTfLiteBuiltinSelectV2:
       return CheckSelectV2GpuDelegateCompatibility(op_sig);
@@ -1045,11 +1062,22 @@ absl::Status CheckGpuDelegateCompatibility(const OpSignature& op_sig,
                                          /*required_outputs=*/2));
       return absl::OkStatus();
 
-    case kTfLiteBuiltinTranspose:
-      RETURN_IF_ERROR(CheckInputsOutputs(op_sig,
-                                         /*required_runtime_inputs=*/1,
-                                         /*required_outputs=*/1));
+    case kTfLiteBuiltinTranspose: {
+      // TRANSPOSE can have 0 or 1 runtime inputs. 0 runtime inputs means
+      // the data tensor is constant.
+      const int runtime_inputs = GetNumberOfRuntimeInputs(op_sig);
+      if (runtime_inputs < 0 || runtime_inputs > 1) {
+        return absl::InternalError(
+            absl::StrCat("Expected 0 or 1 runtime input tensor(s), but node "
+                         "has ", runtime_inputs, " runtime input(s)."));
+      }
+      if (op_sig.outputs.size() != 1) {
+        return absl::InternalError(
+            absl::StrCat("Expected 1 output tensor(s), but node has ",
+                         op_sig.outputs.size(), " output(s)."));
+      }
       return absl::OkStatus();
+    }
 
     case kTfLiteBuiltinTransposeConv: {
       RETURN_IF_ERROR(CheckConvolutionInputOutput(op_sig));
