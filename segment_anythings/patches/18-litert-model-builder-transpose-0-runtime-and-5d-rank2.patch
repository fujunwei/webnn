+    const int runtime_inputs = reader->GetNumberOfRuntimeInputs();
+    ::ml_drift::Tensor<::ml_drift::Linear, ::ml_drift::DataType::INT32> perm;
+    reader->ReadTensor(/*node_input_index=*/1, &perm,
+                       ReadTensorFlags::kNoExtraBytes);
+    if (runtime_inputs == 0) {
+      // All inputs are constant. Read the constant data tensor, apply the
+      // transpose permutation, and emit a CONSTANT node.
+      ::ml_drift::TensorFloat32 attr_tensor;
+      reader->ReadTensor(/*node_input_index=*/0, &attr_tensor,
+                         ReadTensorFlags::kNoExtraBytes);
+      // Transpose the constant data.
+      ::ml_drift::TensorFloat32 transposed;
+      transposed.id = attr_tensor.id;
+      const TfLiteTensor* output = reader->GetOutputTensor(0);
+      if (output && output->dims) {
+        // Compute transposed dimensions.
+        const int rank = output->dims->size;
+        if (rank == 1) {
+          transposed.shape = ::ml_drift::BHWC(1, 1, 1, output->dims->data[0]);
+        } else if (rank == 2) {
+          // Match ExtractTensorShape() convention for 2D tensors so that the
+          // ConstTensorAttributes shape agrees with the graph Value shape
+          // computed by AddOutputs(). Otherwise ReserveGraphTensors() reports:
+          //   "Shape mismatch: {bhwc, {D0, 1, 1, D1}} vs {bhwc, {1, 1, D0, D1}}"
+          // and the delegate falls back to CPU for the whole subgraph (which is
+          // what triggers the ml-drift PartitionAlloc OOM on the SAM encoder).
+          // Physical layout is unchanged: BHWC(D0,1,1,D1) and BHWC(1,1,D0,D1)
+          // both correspond to row-major [D0][D1] on disk.
+          transposed.shape = ::ml_drift::BHWC(output->dims->data[0], 1, 1,
+                                              output->dims->data[1]);
+        } else if (rank == 3) {
+          transposed.shape = ::ml_drift::BHWC(1, output->dims->data[0],
+                                              output->dims->data[1],
+                                              output->dims->data[2]);
+        } else if (rank == 4) {
+          transposed.shape = ::ml_drift::BHWC(output->dims->data[0],
+                                              output->dims->data[1],
+                                              output->dims->data[2],
+                                              output->dims->data[3]);
+        } else {
+          transposed.shape = attr_tensor.shape;
+        }
+      }
+      // Permute the data using the permutation.
+      TransposeConstantData(attr_tensor.shape, perm.data, attr_tensor.data,
