+// Transpose constant tensor data according to the given permutation.
+// Only handles 4D (BHWC) tensors. For other ranks the data is passed through.
+void TransposeConstantData(
+    const ::ml_drift::BHWC& src_shape,
+    const std::vector<int32_t>& perm_data,
+    const std::vector<float>& src_data,
+    const ::ml_drift::BHWC& dst_shape,
+    std::vector<float>& dst_data) {
+  const int B = src_shape.b, H = src_shape.h, W = src_shape.w, C = src_shape.c;
+  const int elements = B * H * W * C;
+  if (perm_data.size() != 4 || elements == 0) {
+    dst_data = src_data;
+    return;
+  }
+  // Compute inverse permutation: inv[perm[i]] = i
+  int inv_perm[4];
+  for (int i = 0; i < 4; ++i) inv_perm[perm_data[i]] = i;
+  const int nB = dst_shape.b, nH = dst_shape.h, nW = dst_shape.w,
+            nC = dst_shape.c;
+  dst_data.resize(elements);
+  int src_coords[4];
+  for (int b = 0; b < nB; ++b) {
+    for (int h = 0; h < nH; ++h) {
+      for (int w = 0; w < nW; ++w) {
+        for (int c = 0; c < nC; ++c) {
+          // output_coords = [b, h, w, c]
+          // src_coords[j] = output_coords[inv_perm[j]]
+          src_coords[0] = inv_perm[0] == 0 ? b : inv_perm[0] == 1 ? h
+                                            : inv_perm[0] == 2 ? w
+                                                               : c;
+          src_coords[1] = inv_perm[1] == 0 ? b : inv_perm[1] == 1 ? h
+                                            : inv_perm[1] == 2 ? w
+                                                               : c;
+          src_coords[2] = inv_perm[2] == 0 ? b : inv_perm[2] == 1 ? h
+                                            : inv_perm[2] == 2 ? w
+                                                               : c;
+          src_coords[3] = inv_perm[3] == 0 ? b : inv_perm[3] == 1 ? h
+                                            : inv_perm[3] == 2 ? w
+                                                               : c;
+          const int src_idx = ((src_coords[0] * H + src_coords[1]) * W +
+                               src_coords[2]) * C + src_coords[3];
+          const int dst_idx =
+              ((b * nH + h) * nW + w) * nC + c;
+          dst_data[dst_idx] = src_data[src_idx];
+        }
+      }
+    }
+  }
+}
