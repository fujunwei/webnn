litert: log buffered error reporter message on invoke failure

When Run() fails, dump the buffered BufferErrorReporter message so
delegate errors are visible in the log.

diff --git a/litert/runtime/compiled_model.cc b/litert/runtime/compiled_model.cc
index ef2a585b3..cce9e8f65 100644
--- a/litert/runtime/compiled_model.cc
+++ b/litert/runtime/compiled_model.cc
@@ -2003,6 +2012,13 @@ Expected<void> LiteRtCompiledModelT::Run(
     if (invoke_status == kTfLiteCancelled) {
       return Unexpected(kLiteRtStatusCancelled, "Execution was cancelled");
     }
+    // Retrieve buffered error messages (e.g. from the delegate) to help
+    // diagnose the invoke failure.
+    if (auto* buffer_reporter =
+            dynamic_cast<litert::BufferErrorReporter*>(error_reporter_.get())) {
+      LITERT_LOG(LITERT_ERROR, "[webnn-run] invoke error: %s",
+                 buffer_reporter->message().c_str());
+    }
     return Unexpected(kLiteRtStatusErrorRuntimeFailure, "Failed to invoke");
   }
