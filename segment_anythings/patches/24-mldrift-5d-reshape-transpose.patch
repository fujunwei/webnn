ml-drift: handle 5D reshape/transpose attributes

Completes 5D (BHWDC) reshape/transpose support in ml-drift:

- add std::any_cast branches for Reshape3DAttributes and
  Transpose3DAttributes in the legacy GPUOperationFromNode selector;
- skip 5D identity-reshape in RemoveIdentityReshape to avoid
  std::bad_any_cast.

NOTE: an earlier revision of this patch also demoted the shape-mismatch
warning in GpuModelBuilder::UpdateOutputTensors to VLOG(1), on the theory
that the mismatch was a harmless axis-relabeling artifact. That was wrong
-- the truncated shape is the one installed by SetOutputDescriptor(), so
the warning marks real data loss. That hunk is deliberately gone; see
patch 26, which removes the mismatch instead of hiding it.

diff --git a/ml_drift/common/selectors/operation_selector.cc b/ml_drift/common/selectors/operation_selector.cc
index c640580..6bd60e7 100644
--- a/ml_drift/common/selectors/operation_selector.cc
+++ b/ml_drift/common/selectors/operation_selector.cc
@@ -1023,11 +1030,17 @@ absl::Status GPUOperationFromNode(const GpuInfo& gpu_info,
       return absl::OkStatus();
     }
     case OperationType::RESHAPE: {
-      const auto& attr =
-          std::any_cast<const ReshapeAttributes&>(node.operation.attributes);
       ABSL_ASSIGN_OR_RETURN(auto src, model_builder->GetTensor(inputs[0]->id));
-      auto output = model_builder->Reshape(src, attr.new_shape);
-      return model_builder->UpdateOutputTensor(output, outputs[0]->id);
+      if (auto* attr3d = std::any_cast<Reshape3DAttributes>(
+              &node.operation.attributes)) {
+        auto output = model_builder->Reshape(src, attr3d->new_shape);
+        return model_builder->UpdateOutputTensor(output, outputs[0]->id);
+      } else {
+        const auto& attr =
+            std::any_cast<const ReshapeAttributes&>(node.operation.attributes);
+        auto output = model_builder->Reshape(src, attr.new_shape);
+        return model_builder->UpdateOutputTensor(output, outputs[0]->id);
+      }
     }
     case OperationType::RESIZE: {
       const auto& attr =
@@ -1123,11 +1136,17 @@ absl::Status GPUOperationFromNode(const GpuInfo& gpu_info,
           model_builder->TopK(src, attr.k), {outputs[0]->id, outputs[1]->id});
     }
     case OperationType::TRANSPOSE: {
-      const auto& attr =
-          std::any_cast<const TransposeAttributes&>(node.operation.attributes);
       ABSL_ASSIGN_OR_RETURN(auto src, model_builder->GetTensor(inputs[0]->id));
-      return model_builder->UpdateOutputTensor(
-          model_builder->Transpose(src, attr.perm), outputs[0]->id);
+      if (auto* attr3d = std::any_cast<Transpose3DAttributes>(
+              &node.operation.attributes)) {
+        return model_builder->UpdateOutputTensor(
+            model_builder->Transpose(src, attr3d->perm), outputs[0]->id);
+      } else {
+        const auto& attr =
+            std::any_cast<const TransposeAttributes&>(node.operation.attributes);
+        return model_builder->UpdateOutputTensor(
+            model_builder->Transpose(src, attr.perm), outputs[0]->id);
+      }
     }
     default:
       ABSL_ASSIGN_OR_RETURN(auto gpu_op, SelectDefault(gpu_info, op_def, node));
diff --git a/ml_drift/common/transformations/remove_noop.cc b/ml_drift/common/transformations/remove_noop.cc
index 3e6f0da..80c41cb 100644
--- a/ml_drift/common/transformations/remove_noop.cc
+++ b/ml_drift/common/transformations/remove_noop.cc
@@ -109,9 +109,19 @@ class RemoveIdentityReshape : public NodeTransformation {
       return {TransformStatus::SKIPPED, ""};
     }
     auto input_shape = graph->FindInputs(node->id)[0]->tensor.shape;
-    const auto& reshape_attr =
-        std::any_cast<const ReshapeAttributes&>(node->operation.attributes);
-    if (input_shape != reshape_attr.new_shape) {
+    // Handle both 4D (ReshapeAttributes) and 5D (Reshape3DAttributes).
+    if (auto* attr4d =
+            std::any_cast<ReshapeAttributes>(&node->operation.attributes)) {
+      if (input_shape != attr4d->new_shape) {
+        return {TransformStatus::SKIPPED, ""};
+      }
+    } else if (std::any_cast<Reshape3DAttributes>(
+                   &node->operation.attributes)) {
+      // For 5D reshape, we can't easily compare with BHWC input_shape.
+      // A 5D reshape is never a simple identity (the rank changes),
+      // so just skip.
+      return {TransformStatus::SKIPPED, ""};
+    } else {
       return {TransformStatus::SKIPPED, ""};
     }
     {
