+      }
     }
     default:
       ABSL_ASSIGN_OR_RETURN(auto gpu_op, SelectDefault(gpu_info, op_def, node));
diff --git a/ml_drift/common/gpu_model_builder.cc b/ml_drift/common/gpu_model_builder.cc
index 21a5da2..61e5c0e 100644
--- a/ml_drift/common/gpu_model_builder.cc
+++ b/ml_drift/common/gpu_model_builder.cc
@@ -3788,8 +3814,12 @@ absl::Status GpuModelBuilder::UpdateOutputTensors(
     if (new_tensor.tensor_desc.GetBHWDCShape() !=
         outputs[i].tensor_desc.GetBHWDCShape()) {
       // Shapes from GraphFloat32 can be calculated differently from
-      // GpuModelBuilder.
-      ABSL_LOG(WARNING)
+      // GpuModelBuilder. This is an upstream-acknowledged limitation for 5D
+      // reshape/transpose axis relabeling; the requested shape is still used
+      // via SetOutputDescriptor() below and execution is unaffected. Demoted
+      // from WARNING to VLOG(1) to silence a large volume of noise during
+      // SAM-encoder compile (WebNN route-A).
+      ABSL_VLOG(1)
           << "Shape mismatch in GpuModelBuilder::UpdateOutputTensors(output of "
           << node.name << "). Requested shape:"
           << ToString(new_tensor.tensor_desc.GetBHWDCShape())
diff --git a/ml_drift/common/transformations/remove_noop.cc b/ml_drift/common/transformations/remove_noop.cc
index 3a1b308..834b919 100644
--- a/ml_drift/common/transformations/remove_noop.cc
+++ b/ml_drift/common/transformations/remove_noop.cc
@@ -109,9 +109,17 @@ class RemoveIdentityReshape : public NodeTransformation {
       return {TransformStatus::SKIPPED, ""};
     }
     auto input_shape = graph->FindInputs(node->id)[0]->tensor.shape;
-    const auto& reshape_attr =
-        std::any_cast<const ReshapeAttributes&>(node->operation.attributes);
-    if (input_shape != reshape_attr.new_shape) {
+    // Handle both 4D (ReshapeAttributes) and 5D (Reshape3DAttributes).
+    if (auto* attr4d = std::any_cast<ReshapeAttributes>(&node->operation.attributes)) {
+      if (input_shape != attr4d->new_shape) {
+        return {TransformStatus::SKIPPED, ""};
+      }
+    } else if (auto* attr5d = std::any_cast<Reshape3DAttributes>(&node->operation.attributes)) {
+      // For 5D reshape, we can't easily compare with BHWC input_shape.
+      // A 5D reshape is never a simple identity (the rank changes),
+      // so just skip.
+      return {TransformStatus::SKIPPED, ""};
+    } else {
       return {TransformStatus::SKIPPED, ""};
     }
