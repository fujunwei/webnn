litert: log per-node GPU/CPU delegation split

Logs how many ops were delegated to GPU vs CPU and which opcodes remain
on CPU, plus ReplaceNodeSubsetsWithDelegateKernels result.

diff --git a/ml_drift_delegate/delegate/delegate_webgpu.cc b/ml_drift_delegate/delegate/delegate_webgpu.cc
index 9578cbb66..fd26fc43e 100644
--- a/ml_drift_delegate/delegate/delegate_webgpu.cc
+++ b/ml_drift_delegate/delegate/delegate_webgpu.cc
@@ -509,6 +510,36 @@ TfLiteStatus DelegatePrepare(TfLiteContext* context, TfLiteDelegate* delegate) {
       context, /*allow_quant_ops=*/true, /*max_delegated_partitions=*/1,
       &kExcludedOps, start_node_index, end_node_index, &custom_parser_factory);
 
+  // Log per-node delegation status so chromium --enable-logging reveals
+  // exactly which ops run on GPU vs CPU.
+  {
+    absl::flat_hash_set<int> delegated_nodes(
+        ops_to_replace->data, ops_to_replace->data + ops_to_replace->size);
+    int gpu_count = 0;
+    int cpu_count = 0;
+    std::string cpu_op_list;
+    for (int i = start_node_index; i < end_node_index; ++i) {
+      TfLiteNode* node = nullptr;
+      TfLiteRegistration* reg = nullptr;
+      if (context->GetNodeAndRegistration(context, i, &node, &reg) !=
+          kTfLiteOk) {
+        continue;
+      }
+      const char* op_name =
+          tflite::EnumNameBuiltinOperator(
+              static_cast<tflite::BuiltinOperator>(reg->builtin_code));
+      if (delegated_nodes.contains(i)) {
+        ++gpu_count;
+      } else {
+        ++cpu_count;
+        absl::StrAppend(&cpu_op_list, "\n  node #", i, ": ", op_name);
+      }
+    }
+    TF_LITE_KERNEL_LOG(
+        context, "========[WebNN][delegate_webgpu.cc] %d ops on GPU, %d ops on CPU%s",
+        gpu_count, cpu_count, cpu_count > 0 ? cpu_op_list.c_str() : "");
+  }
+
 #if defined(__linux__)
   if (auto* env_debug_exclude_nodes = std::getenv(kEnvDebugExcludeNodes)) {
     absl::flat_hash_set<int> excluded_nodes;
@@ -548,8 +579,12 @@ TfLiteStatus DelegatePrepare(TfLiteContext* context, TfLiteDelegate* delegate) {
       .registration_external = nullptr,
       .async_kernel = nullptr,
   };
+  TF_LITE_KERNEL_LOG(context, "[WebNN][delegate] DelegatePrepare: replacing %d ops",
+                     ops_to_replace->size);
   const TfLiteStatus status = context->ReplaceNodeSubsetsWithDelegateKernels(
       context, kRegistration, ops_to_replace, delegate);
+  TF_LITE_KERNEL_LOG(context, "[WebNN][delegate] ReplaceNodeSubsetsWithDelegateKernels %s",
+                     status == kTfLiteOk ? "OK" : "FAILED");
   TfLiteIntArrayFree(ops_to_replace);
   return status;
 }
