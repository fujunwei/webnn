 #include "partition_alloc/partition_alloc_base/debug/alias.h"
+#include "partition_alloc/partition_alloc_base/logging.h"
+#include "partition_alloc/partition_alloc_constants.h"
 
 namespace partition_alloc::internal {
 
@@ -16,6 +18,19 @@ OomFunction g_oom_handling_function = nullptr;
 PA_NOINLINE PA_NOT_TAIL_CALLED void PartitionExcessiveAllocationSize(
     size_t size) {
   PA_NO_CODE_FOLDING();
+  // Diagnostic: when a single allocation exceeds the PartitionAlloc
+  // direct-map limit (MaxDirectMapped()), log the requested size and the
+  // limit so we can see what tried to allocate too much before the process
+  // is terminated by OOM_CRASH below.
+  const size_t max_direct_mapped = MaxDirectMapped();
+  if (size > max_direct_mapped) {
+    PA_LOG(ERROR) << "webnn debug litert [PartitionAlloc][OOM-diag] "
+                     "PartitionExcessiveAllocationSize: requested size="
+                  << size << " bytes exceeds MaxDirectMapped()="
+                  << max_direct_mapped
+                  << " bytes (over by " << (size - max_direct_mapped)
+                  << " bytes). Terminating process.";
+  }
   OOM_CRASH(size);
 }
 
