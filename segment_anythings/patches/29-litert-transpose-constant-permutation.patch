-// Transpose constant tensor data according to the given permutation.
-// Only handles 4D (BHWC) tensors. For other ranks the data is passed through.
+// Re-expresses a TFLite permutation over `rank` axes as a permutation of the
+// four BHWC axes, following the axis placement ExtractTensorShape() uses for
+// that rank. Returns false for ranks this mapping does not cover (1, and >4).
+//
+// Example: rank 2 is laid out as BHWC(D0, 1, 1, D1), so perm [1, 0] moves
+// CHANNELS into BATCH and BATCH into CHANNELS, i.e. BHWC(3, 1, 2, 0).
+bool BhwcPermFromTflitePerm(int rank, const std::vector<int32_t>& perm_data,
+                            ::ml_drift::BHWC* out_perm) {
+  using ::ml_drift::Axis;
+  static const std::map<Axis, int> kAxisToIndex = {{Axis::BATCH, 0},
+                                                   {Axis::HEIGHT, 1},
+                                                   {Axis::WIDTH, 2},
+                                                   {Axis::CHANNELS, 3}};
+  std::vector<Axis> index_to_axis;
+  switch (rank) {
+    case 2:
+      index_to_axis = {Axis::BATCH, Axis::CHANNELS};
+      break;
+    case 3:
+      index_to_axis = {Axis::BATCH, Axis::WIDTH, Axis::CHANNELS};
+      break;
+    case 4:
+      index_to_axis = {Axis::BATCH, Axis::HEIGHT, Axis::WIDTH, Axis::CHANNELS};
+      break;
+    default:
+      return false;
+  }
+  if (static_cast<int>(perm_data.size()) != rank) return false;
+  // Axes the tensor does not use stay where they are.
+  int perm[4] = {0, 1, 2, 3};
+  for (int i = 0; i < rank; ++i) {
+    if (perm_data[i] < 0 || perm_data[i] >= rank) return false;
+    const int dst_axis = kAxisToIndex.at(index_to_axis[i]);
+    const int src_axis = kAxisToIndex.at(index_to_axis[perm_data[i]]);
+    perm[dst_axis] = src_axis;
+  }
+  *out_perm = ::ml_drift::BHWC(perm[0], perm[1], perm[2], perm[3]);
+  return true;
+}
+
+// Transpose constant tensor data according to a BHWC axis permutation, using
+// the same convention as ml_drift::TransposeAttributes: dst axis i is read
+// from src axis perm[i].
