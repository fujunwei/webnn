     const std::vector<float>& src_data,
     const ::ml_drift::BHWC& dst_shape,
     std::vector<float>& dst_data) {
   const int B = src_shape.b, H = src_shape.h, W = src_shape.w, C = src_shape.c;
   const int elements = B * H * W * C;
-  if (perm_data.size() != 4 || elements == 0) {
+  if (elements == 0) {
     dst_data = src_data;
     return;
   }
+  const int perm_data[4] = {perm.b, perm.h, perm.w, perm.c};
   // Compute inverse permutation: inv[perm[i]] = i
   int inv_perm[4];
   for (int i = 0; i < 4; ++i) inv_perm[perm_data[i]] = i;
@@ -5956,7 +5998,9 @@ class TransposeOperationParser : public TFLiteOperationParser {
