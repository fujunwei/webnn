index b655a1b..9a4b367 100644
--- a/ml_drift/common/gpu_model.h
+++ b/ml_drift/common/gpu_model.h
@@ -29,6 +29,7 @@
 #include "ml_drift/common/model.h"
 #include "ml_drift/common/model_hints.h"
 #include "ml_drift/common/precision.h"
+#include "ml_drift/common/shape.h"
 #include "ml_drift/common/task/gpu_operation.h"
 #include "ml_drift/common/task/gpu_tensor.h"
 #include "ml_drift/common/task/tensor_desc.h"
@@ -110,6 +111,19 @@ struct CreateGpuModelInfo {
   // IMPORTANT: tensors ids from predefined / external_immutable_tensors /
   // external_mutable_tensors should not intersect.
   absl::flat_hash_map<ValueId, TensorDescriptor> external_mutable_tensors;
+
+  // True rank-5 shapes for graph values whose tensors are 5D.
+  //
+  // GraphFloat32::Value stores a TensorRef<BHWC>, so a 5D tensor loses its
+  // last dimension by the time it reaches ReserveGraphTensors(): [5,14,5,14,
+  // 768] arrives as BHWC(5,14,5,14). The GPU tensor would then be allocated
+  // 768x too small and every consumer would read garbage. Frontends that can
+  // still see the original rank (e.g. the TFLite delegate, which has the
+  // TfLiteTensor dims) record the real BHWDC here, and ReserveGraphTensors()
+  // uses it instead of value->tensor.shape.
+  //
+  // Only rank 5 is representable; BHWDC has no room for rank 6+.
+  absl::flat_hash_map<ValueId, BHWDC> rank5_shapes;
 };
 
