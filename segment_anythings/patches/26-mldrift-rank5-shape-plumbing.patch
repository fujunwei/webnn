diff --git a/ml_drift/common/gpu_model_util.cc b/ml_drift/common/gpu_model_util.cc
index bd5edc0..1ae4020 100644
--- a/ml_drift/common/gpu_model_util.cc
+++ b/ml_drift/common/gpu_model_util.cc
@@ -210,6 +210,32 @@ absl::StatusOr<TensorDescriptor> GetTensorDescForValue(
     }
   }
 
+  // For a rank-5 value, value->tensor.shape is a truncated BHWC (the frontend
+  // dropped the last dimension to fit TensorRef<BHWC>), so build the
+  // descriptor from the real shape instead. Mirrors the layout selection in
+  // GpuModelBuilder::AddTensor(b, h, w, d, c, ...).
+  if (auto it = create_info.rank5_shapes.find(value->id);
+      it != create_info.rank5_shapes.end()) {
+    const BHWDC& shape_5d = it->second;
+    const bool has_b = shape_5d.b > 1;
+    const bool has_d = shape_5d.d > 1;
+    Layout layout_5d;
+    if (has_b && has_d) {
+      layout_5d = Layout::BHWDC;
+    } else if (has_b) {
+      layout_5d = Layout::BHWC;
+    } else if (has_d) {
+      layout_5d = Layout::HWDC;
+    } else {
+      layout_5d = Layout::HWC;
+    }
+    auto tensor_desc =
+        TensorDescriptor{data_type, create_info.storage_type, layout_5d};
+    ABSL_RETURN_IF_ERROR(
+        tensor_desc.UpdateToSupportedStorageType(gpu_info, shape_5d));
+    return tensor_desc;
+  }
+
   // Initialize the tensor storage type.
   const auto shape = value->tensor.shape;
   Layout layout = shape.b == 1 ? Layout::HWC : Layout::BHWC;
@@ -270,7 +296,12 @@ absl::Status ReserveGraphTensors(const CreateGpuModelInfo& create_info,
     ABSL_ASSIGN_OR_RETURN(auto tensor_desc,
                           GetTensorDescForValue(create_info, gpu_info, graph,
                                                 cast_graph_outputs, value));
-    tensor_desc.SetBHWCShape(value->tensor.shape);
+    if (auto it = create_info.rank5_shapes.find(value->id);
+        it != create_info.rank5_shapes.end()) {
+      tensor_desc.SetBHWDCShape(it->second);
+    } else {
+      tensor_desc.SetBHWCShape(value->tensor.shape);
+    }
     tensor_reserver->Add(value->id, tensor_desc);
     max_id = std::max(max_id, value->id);
   }
