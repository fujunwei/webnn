+    // The batch axes of the two inputs must match, or the mismatch must be
+    // the broadcast case handled in Parse (left has a model batch, right
+    // does not, both rank 4). Anything else (e.g. broadcasting the
+    // matmul-batch axis, or a rank-3 mismatch) is not implemented; refuse
+    // the node so it falls back to CPU instead of computing wrong results.
+    // This applies to both the runtime-inputs and constant-weight paths.
+    const TfLiteTensor* in0 = nullptr;
+    const TfLiteTensor* in1 = nullptr;
+    ABSL_RETURN_IF_ERROR(PreGetInputTensor(context, tflite_node, 0, &in0));
+    ABSL_RETURN_IF_ERROR(PreGetInputTensor(context, tflite_node, 1, &in1));
+    const int r0 = in0->dims->size;
+    const int r1 = in1->dims->size;
+    if (r1 >= 3) {
+      const int lb =
+          r0 >= 4 ? in0->dims->data[0] : (r0 == 3 ? in0->dims->data[0] : 1);
+      const int lh = r0 >= 4 ? in0->dims->data[1] : 1;
+      const int rb =
+          r1 >= 4 ? in1->dims->data[0] : (r1 == 3 ? in1->dims->data[0] : 1);
+      const int rh = r1 >= 4 ? in1->dims->data[1] : 1;
+      const int left_batch = (lb != 1 ? lb : 1) * lh;
+      const int right_batch = (rb != 1 ? rb : 1) * rh;
+      if (left_batch != right_batch &&
+          !(r0 == 4 && r1 == 4 && rb == 1 && lb != 1 && rh == lh) &&
+          !(r0 == 4 && r1 == 4 && rb == lb && rh == 1 && lh > 1 &&
+            tflite::IsConstantTensor(in1))) {
+        return absl::UnavailableError(
+            "Not supported batched mat mul case: batch broadcast not "
+            "implemented");
+      }
+    }
     ABSL_RETURN_IF_ERROR(PreCheckOutputs(context, tflite_node));
     return absl::OkStatus();
   }
