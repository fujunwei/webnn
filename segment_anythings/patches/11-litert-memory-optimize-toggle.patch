litert: document OptimizeMemoryForLargeTensors toggle

Comments out the automatic >1 MiB dynamic allocation calls in
compiled_model.cc (kept as a documented toggle while the delegation path
is being validated) and documents the kTfLiteDelegateFlagsAllowDynamicTensors
flag that would be needed to re-enable it.

Merges former patches 11, 15.

diff --git a/litert/runtime/compiled_model.cc b/litert/runtime/compiled_model.cc
index ef2a585b3..cce9e8f65 100644
--- a/litert/runtime/compiled_model.cc
+++ b/litert/runtime/compiled_model.cc
@@ -405,9 +405,11 @@ Expected<void> LiteRtCompiledModelT::InitializeRuntime(
   // Allocate large tensors (> 1 MiB) dynamically instead of packing them into
   // the single monolithic arena buffer. For large fp32 activations (e.g. WebNN
   // SD-turbo attention scores) the arena high-water-mark otherwise exceeds
-  // PartitionAlloc's ~2 GiB single-allocation cap and crashes in
-  // SimpleMemoryArena::Commit. This also releases dynamic tensors promptly.
-  interpreter_options.OptimizeMemoryForLargeTensors(1 << 20);
+  // Move tensors > 1 MiB out of the arena to kTfLiteDynamic allocation.
+  // This keeps the arena below PartitionAlloc's ~2 GiB single-allocation cap.
+  // The delegate sets kTfLiteDelegateFlagsAllowDynamicTensors so that
+  // static-shaped but dynamically-allocated tensors are accepted.
+  // interpreter_options.OptimizeMemoryForLargeTensors(1 << 20);
   if (jit_compilation_options) {
     auto opaque_options = litert::OpaqueOptions::WrapCObject(
         jit_compilation_options->options, litert::OwnHandle::kNo);
@@ -460,6 +462,13 @@ Expected<void> LiteRtCompiledModelT::InitializeRuntime(
   }
   interp_->SetNumThreads(num_threads);
 
+  // Convert large tensors (> 1 MiB) from kTfLiteArenaRw to kTfLiteDynamic
+  // BEFORE AllocateTensors, so the arena only holds small tensors.
+  // This prevents PartitionAlloc's ~2 GiB single-allocation OOM.
+  // for (int i = 0; i < interp_->subgraphs_size(); ++i) {
+  //   interp_->subgraph(i)->OptimizeMemoryForLargeTensors(1 << 20);
+  // }
+
   if (jit_compilation_options) {
     const auto& bindings = jit_compilation_options->external_tensor_bindings;
     for (const auto& binding : bindings) {
diff --git a/ml_drift_delegate/delegate/delegate_webgpu.cc b/ml_drift_delegate/delegate/delegate_webgpu.cc
index 9578cbb66..fd26fc43e 100644
--- a/ml_drift_delegate/delegate/delegate_webgpu.cc
+++ b/ml_drift_delegate/delegate/delegate_webgpu.cc
@@ -704,6 +739,12 @@ TfLiteDelegatePtr CreateMlDriftWebGpuDelegate(MlDriftDelegateOptionsPtr options,
                              LiteRtDeleteMlDriftWebGpuDelegate);
   delegate->data_ = delegate_data.release();
   delegate->Prepare = DelegatePrepare;
+  // Allow dynamic-allocation tensors (kTfLiteDynamic from
+  // OptimizeMemoryForLargeTensors). These have static shapes but use
+  // malloc instead of arena allocation, reducing arena memory pressure.
+  // Without this flag, TFLite rejects the delegate when any tensor uses
+  // kTfLiteDynamic allocation.
+  // delegate->flags |= kTfLiteDelegateFlagsAllowDynamicTensors;
   if (hint_fully_delegated_to_single_delegate) {
     delegate->flags |= kTfLiteDelegateFlagsHintFullyDelegatedToSingleDelegate;
   }
