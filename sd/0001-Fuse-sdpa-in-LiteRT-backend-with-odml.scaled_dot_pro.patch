+auto GraphBuilderTflite::SerializeInstanceNormalizationAsCustomCall(
+    const mojom::InstanceNormalization& instance_normalization)
+    -> std::optional<OperatorOffset> {
+  // Gate: the fused kernel is only registered by LiteRT when the ML Drift
+  // WebGPU accelerator is selected (see
+  // `third_party/litert/src/litert/runtime/compiled_model.cc`, which calls
+  // `resolver->AddCustom("custom_call.GroupNorm", ...)` only under
+  // `kLiteRtHwAcceleratorGpu`).
+  if (context_device_ != mojom::Device::kGpu) {
+    return std::nullopt;
+  }
+
+  const mojom::Operand& input_operand =
+      GetOperand(instance_normalization.input_operand_id);
+  const auto& input_shape = input_operand.descriptor.shape();
+  const OperandDataType input_dtype = input_operand.descriptor.data_type();
+
+  // ML Drift's group-norm kernel is strictly 4-D BHWC and float.
+  if (input_shape.size() != 4) {
+    return std::nullopt;
+  }
+  if (input_dtype != OperandDataType::kFloat32 &&
+      input_dtype != OperandDataType::kFloat16) {
+    return std::nullopt;
+  }
+  // Chromium serializes instance norm as NHWC, so channels are the last
+  // axis. Anything else would make `num_groups` refer to the wrong
+  // dimension.
+  if (context_properties_.input_operand_layout != InputOperandLayout::kNhwc) {
+    return std::nullopt;
+  }
+  const uint32_t channels = input_shape[3];
+  if (channels == 0) {
+    return std::nullopt;
+  }
+
+  // GroupNormParser reads inputs [x, gamma, beta] positionally and checks
+  // that each is 1-D of exactly `channels`. A bias without a scale would be
+  // read as the scale, so bail on that shape.
+  if (instance_normalization.bias_operand_id &&
+      !instance_normalization.scale_operand_id) {
+    return std::nullopt;
+  }
+  auto is_valid_param = [&](OperandId operand_id) -> bool {
+    const mojom::Operand& op = GetOperand(operand_id);
+    if (op.kind != mojom::Operand::Kind::kConstant) {
+      return false;
+    }
+    if (op.descriptor.data_type() != OperandDataType::kFloat32 &&
+        op.descriptor.data_type() != OperandDataType::kFloat16) {
+      return false;
+    }
+    const auto& s = op.descriptor.shape();
+    return s.size() == 1 && s[0] == channels;
+  };
+  if (instance_normalization.scale_operand_id &&
+      !is_valid_param(*instance_normalization.scale_operand_id)) {
+    return std::nullopt;
+  }
+  if (instance_normalization.bias_operand_id &&
+      !is_valid_param(*instance_normalization.bias_operand_id)) {
+    return std::nullopt;
+  }
+
+  // All preconditions satisfied — emit the custom op.
+  ASSIGN_OR_RETURN(
+      const TensorInfo& input_tensor_info,
+      SerializeInputTensorInfo(instance_normalization.input_operand_id),
+      [](auto) { return std::nullopt; });
+  std::vector<TensorIndex> op_inputs;
+  op_inputs.reserve(3);
+  op_inputs.push_back(input_tensor_info.index);
+  if (instance_normalization.scale_operand_id) {
+    ASSIGN_OR_RETURN(
+        const TensorInfo& scale_tensor_info,
+        SerializeInputTensorInfo(*instance_normalization.scale_operand_id),
+        [](auto) { return std::nullopt; });
+    op_inputs.push_back(scale_tensor_info.index);
+  }
+  if (instance_normalization.bias_operand_id) {
+    ASSIGN_OR_RETURN(
+        const TensorInfo& bias_tensor_info,
+        SerializeInputTensorInfo(*instance_normalization.bias_operand_id),
+        [](auto) { return std::nullopt; });
+    op_inputs.push_back(bias_tensor_info.index);
+  }
+  ASSIGN_OR_RETURN(
+      const TensorInfo output_tensor_info,
+      SerializeOutputTensorInfo(instance_normalization.output_operand_id),
+      [](auto) { return std::nullopt; });
+  const std::array<TensorIndex, 1> op_outputs = {output_tensor_info.index};
+
+  // Attributes flexbuffer: `{"num_groups": int, "epsilon": float}`. Instance
+  // norm normalizes each channel independently, i.e. one channel per group,
+  // so num_groups == channels. GroupNormParser only reads these when
+  // `custom_initial_data` is present -- otherwise it silently defaults to
+  // groups=32/epsilon=1e-6 -- so both must always be written.
+  flexbuffers::Builder fbb;
+  fbb.Map([&] {
+    fbb.Int("num_groups", base::checked_cast<int32_t>(channels));
+    fbb.Float("epsilon", instance_normalization.epsilon);
+  });
+  fbb.Finish();
+  const auto custom_options = builder_.CreateVector(fbb.GetBuffer());
+
+  return ::tflite::CreateOperator(
+      builder_, GetCustomOperatorCodeIndex("custom_call.GroupNorm"),
+      builder_.CreateVector<TensorIndex>(op_inputs),
+      builder_.CreateVector<TensorIndex>(op_outputs),
+      ::tflite::BuiltinOptions_NONE, /*builtin_options=*/0, custom_options,
+      ::tflite::CustomOptionsFormat_FLEXBUFFERS);
+}
