diff --git a/third_party/dawn/workspace.bzl b/third_party/dawn/workspace.bzl
index 4e3cf6481..447f76df4 100644
--- a/third_party/dawn/workspace.bzl
+++ b/third_party/dawn/workspace.bzl
@@ -1,13 +1,53 @@
-"""This file is used to load the dawn library."""
+"""Load Dawn from a prebuilt libdawn.so (webnn route-A WebGPU, design §6d).
 
-load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
+Replaces the upstream 247B dummy stub. Points @dawn at the prebuilt tree
+produced by ml-drift-main/third_party/dawn/build_libdawn.sh
+(default /tmp/dawn/webgpu-dawn-binaries/out/latest, override via DAWN_PREBUILT_DIR),
+and exposes the targets BOTH consumers need:
+  - @ml_drift//ml_drift/webgpu -> @dawn//:webgpu_dawn , @dawn//:webgpu_headers
+  - litert //ml_drift_delegate/delegate -> @dawn//dawn:webgpu_dawn , @dawn//dawn:dawn_headers
+all aliased onto one prebuilt cc_library. See webnn-mldrift-gpu-integration-design.md §6d.
+"""
 
-def repo():
-    http_archive(
-        name = "dawn",
-        add_prefix = "dawn",
-        urls = [
-            "https://github.com/google/dawn/archive/v20250713.025201.tar.gz",
-        ],
-        build_file = "//third_party/dawn:BUILD",
+_ROOT_BUILD = """
+cc_library(
+    name = "libdawn",
+    hdrs = glob(["include/**/*.h*"]),
+    includes = ["include"],
+    srcs = ["lib/libdawn.so"],
+    visibility = ["//visibility:public"],
+)
+
+alias(name = "webgpu_dawn", actual = ":libdawn", visibility = ["//visibility:public"])
+
+alias(name = "webgpu_headers", actual = ":libdawn", visibility = ["//visibility:public"])
+
+alias(name = "dawn_headers", actual = ":libdawn", visibility = ["//visibility:public"])
+"""
+
+_DAWN_PKG_BUILD = """
+alias(name = "webgpu_dawn", actual = "@dawn//:libdawn", visibility = ["//visibility:public"])
+
+alias(name = "dawn_headers", actual = "@dawn//:libdawn", visibility = ["//visibility:public"])
+"""
+
+def _prebuilt_dawn_impl(ctx):
+    path = ctx.os.environ.get(
+        "DAWN_PREBUILT_DIR",
+        "/tmp/dawn/webgpu-dawn-binaries/out/latest",
     )
+    for d in ["include", "lib"]:
+        res = ctx.execute(["bash", "-c", "mkdir -p %s && cp -RL %s/%s/. %s/" % (d, path, d, d)])
+        if res.return_code != 0:
+            fail("prebuilt_dawn: copy '%s' from '%s' failed: %s" % (d, path, res.stderr))
+    ctx.file("BUILD", _ROOT_BUILD)
+    ctx.file("dawn/BUILD", _DAWN_PKG_BUILD)
+
+prebuilt_dawn = repository_rule(
+    implementation = _prebuilt_dawn_impl,
+    environ = ["DAWN_PREBUILT_DIR"],
+    local = True,
+)
+
+def repo():
+    prebuilt_dawn(name = "dawn")
