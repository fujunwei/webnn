-"""This file is used to load the dawn library."""
+"""Load Dawn from a prebuilt webgpu_dawn.dll / libdawn.so (webnn route-A WebGPU, Windows port).
 
-load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
+Replaces the upstream http_archive stub. Upstream's `dawn.BUILD` declares
+headers-only cc_library targets (it globs `include/**/*.h` with no `srcs`), so
+an out-of-tree `.dll` built against it has no Dawn implementation to link
+against. Point @dawn at the prebuilt tree produced by webgpu-dawn-binaries
+instead (CMake on Windows via scripts/build_dawn.ps1, or build_libdawn.sh on
+Linux). Override the location via the DAWN_PREBUILT_DIR env var.
+
+Exposes the labels consumers reference:
+  - @dawn//:webgpu_dawn , @dawn//:webgpu_headers
+  - @dawn//:dawn_headers , @dawn//:libdawn_proc
+  - @dawn//dawn:webgpu_dawn , @dawn//dawn:dawn_headers
+"""
+
+# Windows BUILD template — references webgpu_dawn.dll
+_WIN_ROOT_BUILD = """
+cc_import(
+    name = "dawn_import",
+    interface_library = "lib/webgpu_dawn.lib",
+    shared_library = "lib/webgpu_dawn.dll",
+    visibility = ["//visibility:public"],
+)
+
+cc_library(
+    name = "libdawn",
+    hdrs = glob(["include/**/*.h*"]),
+    includes = ["include"],
+    deps = [":dawn_import"],
+    visibility = ["//visibility:public"],
+)
+
+alias(name = "webgpu_dawn",    actual = ":libdawn", visibility = ["//visibility:public"])
+alias(name = "webgpu_headers", actual = ":libdawn", visibility = ["//visibility:public"])
+alias(name = "dawn_headers",   actual = ":libdawn", visibility = ["//visibility:public"])
+alias(name = "libdawn_proc",   actual = ":libdawn", visibility = ["//visibility:public"])
+"""
+
+# Linux/macOS BUILD template — references libdawn.so / libdawn.dylib
+_POSIX_ROOT_BUILD = """
+cc_library(
+    name = "libdawn",
+    hdrs = glob(["include/**/*.h*"]),
+    includes = ["include"],
+    srcs = glob(["lib/libdawn.*"]),
+    visibility = ["//visibility:public"],
+)
+
+alias(name = "webgpu_dawn",    actual = ":libdawn", visibility = ["//visibility:public"])
+alias(name = "webgpu_headers", actual = ":libdawn", visibility = ["//visibility:public"])
+alias(name = "dawn_headers",   actual = ":libdawn", visibility = ["//visibility:public"])
+alias(name = "libdawn_proc",   actual = ":libdawn", visibility = ["//visibility:public"])
+"""
+
+_DAWN_PKG_BUILD = """
+alias(name = "webgpu_dawn",  actual = "@dawn//:libdawn", visibility = ["//visibility:public"])
+alias(name = "dawn_headers", actual = "@dawn//:libdawn", visibility = ["//visibility:public"])
+"""
+
+def _prebuilt_dawn_impl(ctx):
+    is_win = ctx.os.name.startswith("windows")
+    default_dir = "C:\\\\Users\\\\junwei\\\\workspace\\\\webnn\\\\_dawn_prebuilt_win" if is_win else "/tmp/dawn/webgpu-dawn-binaries/out/latest"
+    path = ctx.os.environ.get("DAWN_PREBUILT_DIR", default_dir)
+
+    for d in ["include", "lib"]:
+        ctx.execute(["mkdir", "-p", d] if not is_win else ["cmd", "/c", "mkdir", d], quiet = True)
+        if is_win:
+            # xcopy /E /I /Y /Q: recursive, treat dest as dir, overwrite, quiet
+            src = path.rstrip("\\\\") + "\\\\" + d
+            res = ctx.execute(["cmd", "/c", "xcopy", "/E", "/I", "/Y", "/Q", src, d])
+        else:
+            res = ctx.execute(["bash", "-c", "cp -RL %s/%s/. %s/" % (path, d, d)])
+        if res.return_code != 0:
+            fail("prebuilt_dawn: copy '%s' from '%s' failed: %s" % (d, path, res.stderr))
+
+    build_content = _WIN_ROOT_BUILD if is_win else _POSIX_ROOT_BUILD
+    ctx.file("BUILD", build_content)
+    ctx.file("dawn/BUILD", _DAWN_PKG_BUILD)
+
+prebuilt_dawn = repository_rule(
+    implementation = _prebuilt_dawn_impl,
+    environ = ["DAWN_PREBUILT_DIR"],
+    local = True,
+)
 
